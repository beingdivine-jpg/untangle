# Server-side only. Copy to .env.local, fill locally, then restart npm run dev.
# Never use a VITE_ prefix for a secret or paste a key into the browser.
OPENAI_API_KEY=
# Choose a Responses API model with Structured Outputs available to your project.
OPENAI_MODEL=

# Optional hosted accounts + verified volunteer service (server-side only).
# Apply supabase/migrations/202610040001_support.sql before enabling.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
COMMUNITY_ENABLED=false
# Enable only after model evaluations and operational review (see docs/services.html).
LIVE_COACH_ENABLED=false
