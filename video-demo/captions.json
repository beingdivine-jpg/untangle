[
  {
    "start": 0.614,
    "end": 4.304,
    "text": "After a breakup, your digital life can stay tangled."
  },
  {
    "start": 7.477,
    "end": 10.291,
    "text": "Untangle helps you find a starting point."
  },
  {
    "start": 12.464,
    "end": 13.499,
    "text": "Meet Maya."
  },
  {
    "start": 13.78,
    "end": 16.757,
    "text": "She changed her password, but still has questions"
  },
  {
    "start": 16.757,
    "end": 19.042,
    "text": "about the laptop and shared photos."
  },
  {
    "start": 20.49,
    "end": 23.622,
    "text": "Her story becomes six checks, with preparation"
  },
  {
    "start": 23.622,
    "end": 24.824,
    "text": "steps included."
  },
  {
    "start": 25.092,
    "end": 26.9,
    "text": "She chooses what to keep."
  },
  {
    "start": 28.514,
    "end": 31.453,
    "text": "Before deciding, she explores what a password"
  },
  {
    "start": 31.453,
    "end": 34.201,
    "text": "change affects, and what it leaves outside."
  },
  {
    "start": 37.514,
    "end": 39.271,
    "text": "The checks become her plan."
  },
  {
    "start": 39.552,
    "end": 42.439,
    "text": "She can keep an unanswered question without marking"
  },
  {
    "start": 42.439,
    "end": 43.293,
    "text": "it reviewed."
  },
  {
    "start": 46.477,
    "end": 49.763,
    "text": "Save an encrypted file to pick up later, or review"
  },
  {
    "start": 49.763,
    "end": 51.907,
    "text": "those questions with someone you trust."
  },
  {
    "start": 53.414,
    "end": 54.385,
    "text": "Your pace."
  },
  {
    "start": 54.679,
    "end": 55.778,
    "text": "Your permission."
  },
  {
    "start": 56.045,
    "end": 57.041,
    "text": "Untangle."
  },
  {
    "start": 57.321,
    "end": 58.961,
    "text": "A little less tangled."
  }
]
