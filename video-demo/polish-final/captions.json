[
  {
    "start": 0.337,
    "end": 0.992,
    "text": "Rozstanie."
  },
  {
    "start": 1.713,
    "end": 3.187,
    "text": "Cyfrowe po\u0142\u0105czenia zostaj\u0105."
  },
  {
    "start": 3.919,
    "end": 5.022,
    "text": "Razem z ryzykiem."
  },
  {
    "start": 6.345,
    "end": 7.167,
    "text": "Untangle."
  },
  {
    "start": 7.891,
    "end": 9.902,
    "text": "Tw\u00f3j prywatny przewodnik po rozstaniu."
  },
  {
    "start": 11.287,
    "end": 12.611,
    "text": "Maja zmieni\u0142a has\u0142o."
  },
  {
    "start": 13.273,
    "end": 14.771,
    "text": "Co z laptopem i zdj\u0119ciami?"
  },
  {
    "start": 15.497,
    "end": 17.006,
    "text": "Sprawdza demo krok po kroku."
  },
  {
    "start": 18.294,
    "end": 20.089,
    "text": "Sze\u015b\u0107 krok\u00f3w z jednej historii."
  },
  {
    "start": 20.883,
    "end": 23.58,
    "text": "Najpierw odzyskiwanie dost\u0119pu, potem urz\u0105dzenia"
  },
  {
    "start": 23.601,
    "end": 24.248,
    "text": "i zdj\u0119cia."
  },
  {
    "start": 25.053,
    "end": 25.888,
    "text": "Maja wybiera."
  },
  {
    "start": 27.3,
    "end": 30.02,
    "text": "Po pod\u0142\u0105czeniu AI agent si\u0119ga do poradnika."
  },
  {
    "start": 30.875,
    "end": 33.525,
    "text": "Wyja\u015bnia krok, m\u00f3wi dlaczego i proponuje dalsze"
  },
  {
    "start": 33.525,
    "end": 34.157,
    "text": "dzia\u0142anie."
  },
  {
    "start": 35.0,
    "end": 36.732,
    "text": "Ty oceniasz ka\u017cd\u0105 sugesti\u0119."
  },
  {
    "start": 39.295,
    "end": 40.551,
    "text": "Has\u0142o to nie wszystko."
  },
  {
    "start": 41.284,
    "end": 44.163,
    "text": "Podgl\u0105d pokazuje skutki, ograniczenia i \u017ar\u00f3d\u0142o."
  },
  {
    "start": 44.895,
    "end": 46.863,
    "text": "Asystent pomaga zapisa\u0107 pytanie."
  },
  {
    "start": 48.287,
    "end": 49.177,
    "text": "Popraw notatk\u0119."
  },
  {
    "start": 49.882,
    "end": 50.827,
    "text": "Zatwierd\u017a plan."
  },
  {
    "start": 51.477,
    "end": 52.975,
    "text": "Kroki czekaj\u0105 na sprawdzenie."
  },
  {
    "start": 53.691,
    "end": 56.014,
    "text": "Dopiero Twoja obserwacja zmieni ich status."
  },
  {
    "start": 57.3,
    "end": 58.432,
    "text": "Plan to pocz\u0105tek."
  },
  {
    "start": 59.275,
    "end": 62.07,
    "text": "Przejd\u017a przez instrukcj\u0119, sprawd\u017a, czy j\u0105 rozumiesz,"
  },
  {
    "start": 62.125,
    "end": 63.483,
    "text": "i zapisz w\u0142asny wynik."
  },
  {
    "start": 64.338,
    "end": 65.295,
    "text": "W swoim tempie."
  },
  {
    "start": 67.286,
    "end": 68.143,
    "text": "Ja\u015bniejszy krok."
  },
  {
    "start": 68.846,
    "end": 69.875,
    "text": "Wi\u0119cej zrozumienia."
  },
  {
    "start": 70.599,
    "end": 71.959,
    "text": "Droga do pomocy cz\u0142owieka."
  },
  {
    "start": 73.335,
    "end": 74.047,
    "text": "Twoje \u017cycie."
  },
  {
    "start": 74.742,
    "end": 75.624,
    "text": "Twoje zasady."
  },
  {
    "start": 76.288,
    "end": 77.032,
    "text": "Untangle."
  }
]
