[
  {
    "start": 0.538,
    "end": 2.658,
    "text": "A breakup ends a relationship."
  },
  {
    "start": 2.913,
    "end": 4.933,
    "text": "Not every digital connection."
  },
  {
    "start": 6.418,
    "end": 7.584,
    "text": "Meet Untangle."
  },
  {
    "start": 7.84,
    "end": 10.442,
    "text": "Your private guide, with optional AI."
  },
  {
    "start": 11.365,
    "end": 13.05,
    "text": "Maya changed her password."
  },
  {
    "start": 13.264,
    "end": 15.674,
    "text": "But the shared laptop, and their photos?"
  },
  {
    "start": 15.911,
    "end": 17.458,
    "text": "She still has questions."
  },
  {
    "start": 18.409,
    "end": 21.019,
    "text": "Six checks connect accounts and photos."
  },
  {
    "start": 21.262,
    "end": 24.393,
    "text": "Recovery access comes before password changes."
  },
  {
    "start": 24.635,
    "end": 26.448,
    "text": "Every step stays visible."
  },
  {
    "start": 27.425,
    "end": 31.075,
    "text": "Agentic help, with clear roles: AI selects guides"
  },
  {
    "start": 31.075,
    "end": 32.545,
    "text": "and clarifies notes."
  },
  {
    "start": 32.8,
    "end": 34.582,
    "text": "The app adds preparation."
  },
  {
    "start": 34.825,
    "end": 38.395,
    "text": "Preview this prepared wording, accept, or undo."
  },
  {
    "start": 39.412,
    "end": 42.075,
    "text": "Before changing anything, see what a password"
  },
  {
    "start": 42.075,
    "end": 44.732,
    "text": "change affects, and what it leaves outside."
  },
  {
    "start": 45.0,
    "end": 47.407,
    "text": "The explanation links to its source."
  },
  {
    "start": 48.4,
    "end": 50.07,
    "text": "Keep the steps you choose."
  },
  {
    "start": 50.325,
    "end": 52.82,
    "text": "An unanswered question stays a question."
  },
  {
    "start": 53.087,
    "end": 55.62,
    "text": "Reading a guide never marks it reviewed."
  },
  {
    "start": 57.425,
    "end": 59.145,
    "text": "Save an encrypted file."
  },
  {
    "start": 59.387,
    "end": 63.0,
    "text": "Open it later, and your checks, notes, and questions"
  },
  {
    "start": 63.0,
    "end": 63.795,
    "text": "come back."
  },
  {
    "start": 64.037,
    "end": 65.695,
    "text": "No account to create."
  },
  {
    "start": 67.4,
    "end": 68.69,
    "text": "Less guesswork."
  },
  {
    "start": 68.969,
    "end": 70.533,
    "text": "A clearer next step."
  },
  {
    "start": 70.787,
    "end": 72.439,
    "text": "And the choice stays yours."
  },
  {
    "start": 73.462,
    "end": 74.345,
    "text": "Your life."
  },
  {
    "start": 74.625,
    "end": 75.608,
    "text": "Your terms."
  },
  {
    "start": 75.862,
    "end": 76.82,
    "text": "Untangle."
  }
]
